{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/agent-evals/schemas/a2a_response.v1.json",
  "title": "Agent A2A response v1",
  "description": "JSON-RPC envelope wrapping a Task with the v1 agent response shape. Metadata keys use a configurable namespace prefix (default: agent).",
  "type": "object",
  "required": ["jsonrpc", "id", "result"],
  "properties": {
    "jsonrpc": { "const": "2.0" },
    "id": {},
    "result": { "$ref": "#/$defs/Task" }
  },
  "$defs": {
    "Task": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string" },
        "contextId": { "type": "string" },
        "context_id": { "type": "string" },
        "kind": { "const": "task" },
        "status": { "$ref": "#/$defs/TaskStatus" },
        "history": {
          "type": "array",
          "items": { "$ref": "#/$defs/Message" }
        },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/Artifact" }
        },
        "metadata": { "$ref": "#/$defs/TaskMetadata" }
      }
    },
    "TaskStatus": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {
          "enum": [
            "submitted",
            "working",
            "input-required",
            "input_required",
            "completed",
            "failed",
            "canceled",
            "rejected",
            "auth-required",
            "auth_required"
          ]
        },
        "timestamp": { "type": "string" },
        "message": { "$ref": "#/$defs/Message" }
      }
    },
    "Message": {
      "type": "object",
      "required": ["role", "parts"],
      "properties": {
        "kind": { "type": "string" },
        "messageId": { "type": "string" },
        "message_id": { "type": "string" },
        "role": { "type": "string" },
        "parts": {
          "type": "array",
          "items": { "$ref": "#/$defs/Part" }
        },
        "metadata": { "type": "object" }
      }
    },
    "Part": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "text" },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "data" },
            "data": { "type": "object" }
          }
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "file" }
          }
        }
      ]
    },
    "Artifact": {
      "type": "object",
      "required": ["parts"],
      "properties": {
        "artifactId": { "type": "string" },
        "artifact_id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "parts": {
          "type": "array",
          "items": { "$ref": "#/$defs/Part" }
        },
        "metadata": { "type": "object" }
      }
    },
    "TaskMetadata": {
      "type": "object",
      "properties": {
        "agent.schema_version": { "type": "string" },
        "agent.latency_ms": { "type": "integer", "minimum": 0 },
        "agent.tokens": {
          "type": "object",
          "properties": {
            "input": { "type": "integer", "minimum": 0 },
            "output": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 }
          }
        },
        "agent.agent_token_totals": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "input": { "type": "integer", "minimum": 0 },
              "output": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "agent.models": {
          "type": "array",
          "items": { "type": "string" }
        },
        "agent.cost": {
          "type": "object",
          "required": ["usd", "rates_version"],
          "properties": {
            "usd": { "type": "number", "minimum": 0 },
            "rates_version": { "type": "string" },
            "by_model": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "input_per_1k": { "type": "number" },
                  "output_per_1k": { "type": "number" }
                }
              }
            }
          }
        },
        "agent.cost_unknown_models": {
          "type": "array",
          "items": { "type": "string" }
        },
        "agent.user_id": { "type": "string" },
        "agent.identity_source": {
          "enum": ["a2a-message-metadata", "jwt", "context-id"]
        },
        "agent.error": {
          "type": "object",
          "required": ["code", "type"],
          "properties": {
            "code": {
              "enum": [
                "auth_error",
                "tool_error",
                "llm_error",
                "interrupt_resume_error",
                "validation_error",
                "internal_error"
              ]
            },
            "type": { "type": "string" }
          }
        }
      }
    },
    "TraceArtifactData": {
      "type": "object",
      "required": ["schema", "trace_id", "events"],
      "properties": {
        "schema": { "const": "agent/Trace@v1" },
        "trace_id": { "type": "string" },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/TraceEvent" }
        },
        "agent_token_totals": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "input": { "type": "integer" },
              "output": { "type": "integer" }
            }
          }
        }
      }
    },
    "TraceEvent": {
      "type": "object",
      "required": ["span_id", "sequence", "type", "agent_id"],
      "properties": {
        "span_id": { "type": "string" },
        "parent_span_id": { "type": ["string", "null"] },
        "sequence": { "type": "integer", "minimum": 0 },
        "type": {
          "enum": [
            "route",
            "reasoning",
            "tool_call",
            "tool_result",
            "agent_message",
            "handoff",
            "interrupt",
            "resume"
          ]
        },
        "agent_id": { "type": "string" },
        "timestamp": { "type": "string" },
        "data": { "type": "object" }
      }
    },
    "ErrorPart": {
      "type": "object",
      "required": ["schema", "code", "type", "message"],
      "properties": {
        "schema": { "const": "agent/Error@v1" },
        "code": {
          "enum": [
            "auth_error",
            "tool_error",
            "llm_error",
            "interrupt_resume_error",
            "validation_error",
            "internal_error"
          ]
        },
        "type": { "type": "string" },
        "message": { "type": "string" },
        "retriable": { "type": "boolean" },
        "agent_id": { "type": "string" }
      }
    },
    "RefusalPart": {
      "type": "object",
      "required": ["schema", "reason"],
      "properties": {
        "schema": { "const": "agent/Refusal@v1" },
        "reason": { "type": "string" },
        "policy": { "type": "string" }
      }
    }
  }
}
