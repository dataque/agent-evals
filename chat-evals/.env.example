# LLM judge for MLflow GenAI scorers (--mode local).
# Configure ONE of the options below.

# Option A — OpenAI (direct):
OPENAI_API_KEY=
# JUDGE_MODEL=openai:/gpt-4o          # optional; defaults to openai:/gpt-4o when OPENAI_API_KEY is set

# Option B — Azure OpenAI:
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# JUDGE_MODEL=azure:/gpt-4o           # optional; defaults to azure:/<deployment>

# A2A endpoint (only used directly by evals/test_a2a.py — the main flow reads targets.yaml)
A2A_BASE_URL=
A2A_FUNC_KEY=

# Optional: metadata namespace your agent uses in A2A task metadata (default: agent)
# e.g. if your agent emits "myagent.latency_ms", set A2A_METADATA_NS=myagent
# A2A_METADATA_NS=agent
