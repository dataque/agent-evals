{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "suggest_requisitions result",
  "description": "Mirrors SuggestRequisitionsOutput ({ matches: RequisitionMatch[], count }). matchScore is the backend RequisitionMatchScore enum (GOOD | STRONG) — kept lenient as a string. Each match embeds the full requisition (ViewRequisitionOutput) incl. a resolved recruiter.",
  "type": "object",
  "required": ["matches"],
  "additionalProperties": true,
  "properties": {
    "count": { "type": ["integer", "null"] },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requisition"],
        "additionalProperties": true,
        "properties": {
          "matchScore": { "type": ["string", "number", "null"] },
          "matchReasoning": { "type": ["string", "null"] },
          "gapReasoning": { "type": ["string", "null"] },
          "rerankerScore": { "type": ["number", "null"] },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "additionalProperties": true,
              "properties": { "name": { "type": "string" } }
            }
          },
          "requisition": {
            "type": "object",
            "required": ["requisitionId"],
            "additionalProperties": true,
            "properties": {
              "requisitionId": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
