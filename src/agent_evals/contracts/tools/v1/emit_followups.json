{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "emit_followups result",
  "description": "Mirrors the frontend EmitFollowupsCard result. scenario_id is snake_case per backend @JsonProperty.",
  "type": "object",
  "required": ["pills"],
  "additionalProperties": true,
  "properties": {
    "pills": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string", "maxLength": 60 }
        }
      }
    },
    "scenario_id": { "type": ["string", "null"] }
  }
}
