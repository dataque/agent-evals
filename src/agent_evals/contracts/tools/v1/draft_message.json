{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "draft_message result",
  "description": "Mirrors the frontend DraftMessageCard result (DraftMessageToolResult).",
  "type": "object",
  "required": ["recipients", "subject", "body"],
  "additionalProperties": true,
  "properties": {
    "recipients": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["email"],
        "additionalProperties": true,
        "properties": {
          "firstName": { "type": ["string", "null"] },
          "lastName": { "type": ["string", "null"] },
          "email": { "type": "string" }
        }
      }
    },
    "subject": { "type": "string" },
    "body": { "type": "string" }
  }
}
