# Copy to `.env` (gitignored) and fill in. The CLI (`agent-evals`) auto-loads it.
# Config in targets.yaml references these as ${VAR}.

# Your real user login id that HAS a profile in the datastore.
# The agent serves only the CALLER's own profile, so a missing/fake id makes it
# reply "I can't find your profile".
AGENT_EVALS_USER_LOGIN_ID=

# --- System-under-test endpoint, one per target in targets.yaml (referenced as ${VAR}) ---
# local: optional — defaults to localhost if unset.
# AGENT_EVALS_LOCAL_BASE_URL=http://localhost:8080/api/v1/bff/ai/agent/sse
# devpod: REQUIRED to use `--target devpod` — your forwarded HTTPS URL (uncomment + fill).
# AGENT_EVALS_DEVPOD_BASE_URL=https://your-forwarded-devpod-host/api/v1/bff/ai/agent/sse

# --- Backend LLM, recorded into params.json (E19) ---
# The harness asks the backend's actuator first (gen_ai.client.operation for the
# model, configprops/env for reasoning effort and API version). These are the
# fallback for whatever it does not expose; set them (or pass --model /
# --deployment / --reasoning-effort / --api-version) so a backend with no
# actuator still produces artifacts that name the model behind them.
# AGENT_EVALS_LOCAL_MODEL=gpt-5.5
# AGENT_EVALS_LOCAL_DEPLOYMENT=
# AGENT_EVALS_LOCAL_REASONING_EFFORT=medium
# AGENT_EVALS_LOCAL_API_VERSION=
# AGENT_EVALS_DEVPOD_MODEL=
# AGENT_EVALS_DEVPOD_DEPLOYMENT=
# AGENT_EVALS_DEVPOD_REASONING_EFFORT=
# AGENT_EVALS_DEVPOD_API_VERSION=

# --- Live smoke test (tests/test_live_smoke.py) ---
# Setting AGENT_EVALS_LIVE_URL un-skips the live test.
# AGENT_EVALS_LIVE_URL=http://localhost:8080/api/v1/bff/ai/agent/sse
# AGENT_EVALS_TOKEN=             # a real bearer token instead of a minted one (optional)
# AGENT_EVALS_USE_TRUSTSTORE=1   # corporate/private-CA endpoints via the OS trust store

# --- LLM judge (for --judge azure_openai) ---
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT_NAME=
