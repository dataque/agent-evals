# Azure OpenAI — judge LLM for MLflow GenAI scorers (hr_agent_poc project)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Entra ID OAuth2 — eval credentials for backend production target
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_SCOPE=
# Optional MSAL token-cache file path (defaults to in-memory)
ENTRA_TOKEN_CACHE_PATH=

# Optional override: bypass targets.yaml entirely
AGENT_EVALS_BASE_URL=
AGENT_EVALS_AUTH_TOKEN=
