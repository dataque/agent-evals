# Copy to `.env` (gitignored) and fill in. The CLI (`agent-evals`) auto-loads it.
# Config in targets.yaml references these as ${VAR}.

# Your real GPN that HAS a talent profile in the dev datastore.
# The agent serves only the CALLER's own profile, so a missing/fake GPN makes it
# reply "I can't find your profile".
AGENT_EVALS_GPN=

# --- Live smoke test (tests/test_live_smoke.py) ---
# Setting AGENT_EVALS_LIVE_URL un-skips the live test.
# AGENT_EVALS_LIVE_URL=http://localhost:8080/api/v1/bff/ai/agent/sse
# AGENT_EVALS_TOKEN=             # a real bearer token instead of a minted one (optional)
# AGENT_EVALS_USE_TRUSTSTORE=1   # corporate/private-CA endpoints via the OS trust store

# --- LLM judge (default backend: langchain_azure) ---
# The judge builds the SAME langchain_openai.AzureChatOpenAI client the hr-agent
# uses. COPY THESE FOUR FROM THE hr-agent's .env on this pod — especially the
# ENDPOINT: the judge can only reach the deployment over the same path the agent
# already uses (the raw cirruspl-*.openai.azure.com host has public access
# disabled → 403). Same machine + same client + same values = it works.
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_DEPLOYMENT_NAME=
# AZURE_OPENAI_JUDGE_TEMPERATURE=0      # 0 = deterministic; raise if a deployment rejects 0
# If the agent reaches Azure via a proxy, export the same here so the judge does too:
# HTTPS_PROXY=  HTTP_PROXY=  NO_PROXY=azpriv-cloud.ubs.net,localhost,127.0.0.1
